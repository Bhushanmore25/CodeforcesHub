{
  "manifest_version": 3,
  "name": "CodeforcesHub",
  "version": "1.0.0",
  "description": "Automatically integrate your Codeforces Accepted submissions to GitHub",
  "permissions": [
    "storage",
    "webNavigation",
    "activeTab",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://codeforces.com/*",
    "https://github.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CodeforcesHub"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://codeforces.com/*"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://github.com/*"],
      "js": ["scripts/authorize.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
